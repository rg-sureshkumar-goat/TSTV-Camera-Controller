{
  "name": "tstv-cam-controller",
  "productName": "Cam Controller",
  "version": "0.3.0",
  "description": "TSTV Cam Controller: controls the studio's Panasonic PTZ cameras (replaces the AW-RP50)",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron-vite build && electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "mock-cameras": "node tools/mock-cameras.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
